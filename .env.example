DATABASE_URL=postgres://postgres:password@localhost:5432/cvscreening?sslmode=disable
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=168h
AI_SERVICE_URL=http://localhost:8000
AI_MOCK=false
FRONTEND_URL=http://localhost:3000
PORT=3001
MAX_CV_SIZE_MB=5
COOKIE_SECURE=false

# --- Auth hardening (2026-07-03) -------------------------------------------
# Resend (email verification). Kosongkan untuk nonaktifkan (akun auto-verified).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Cloudflare Turnstile (captcha di /auth/register). Kosongkan untuk nonaktifkan.
TURNSTILE_SECRET_KEY=
# Batas analisis/30 hari untuk akun terdaftar (sebelumnya tidak ada batas sama sekali).
REGISTERED_MONTHLY_QUOTA=20
# Batas akun guest baru per IP per hari (cegah "hapus cookie = gratis 3x lagi").
GUEST_SIGNUPS_PER_IP_PER_DAY=3
